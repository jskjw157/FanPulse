# ─── PostgreSQL ───
POSTGRES_DB=fanpulse
POSTGRES_USER=fanpulse
POSTGRES_PASSWORD=fanpulse

# ─── Spring Boot ───
JWT_SECRET=change-me-in-production-at-least-256-bits-long
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FANPULSE_SCHEDULER_LIVE_DISCOVERY_ENABLED=true
FANPULSE_SCHEDULER_METADATA_REFRESH_ENABLED=true
FANPULSE_SCHEDULER_LIVE_DISCOVERY_MAX_CONCURRENCY=2
FANPULSE_CHART_REFRESH_ENABLED=true
FANPULSE_CHART_REFRESH_CRON=0 30 10 * * MON

# ─── Django AI Sidecar ───
AI_API_KEY=test-api-key

# ─── Real news collection ───
# auto uses Naver when both credentials exist, otherwise Google News RSS.
NEWS_COLLECTION_PROVIDER=auto
NEWS_COLLECTION_INTERVAL_SECONDS=1800
NEWS_COLLECTION_MAX_ARTISTS=30
NEWS_COLLECTION_PER_ARTIST=10
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
